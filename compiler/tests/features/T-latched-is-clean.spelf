module Feature.LatchedClean
extern fn read_contact() -> Suspect<bool>;
state touchdown: Latch = latch(persists_for = 3);
state engines_off: bool = false;
fn update() {
  match read_contact() {
    Valid(c) => feed(touchdown, c),
    _ => feed(touchdown, false),
  }
  if is_set(touchdown) { engines_off = true; }
}
