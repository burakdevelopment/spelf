module Feature.VoteTolOk
fault_hypothesis FH { channel_faults = 1, fault_mode = value }
redundancy G { channels = 3, hypothesis = FH, exchange = consistent_broadcast, skew_us = 2000 }
@voter(G, tolerance = 0.8[deg], signal_rate = 300.0[deg/s])
fn vote(a: Float<deg, -90.0..=90.0>, b: Float<deg, -90.0..=90.0>, c: Float<deg, -90.0..=90.0>) -> Float<deg, -90.0..=90.0> {
  if a <= b { if b <= c { b } else { if a <= c { c } else { a } } }
  else { if a <= c { a } else { if b <= c { c } else { b } } }
}
