module Feature.Float32
fn gain(x: Float32<1, -10.0..=10.0>) -> Float32<1, -30.0..=30.0> {
  x * 2.5 + 0.1 - 0.1
}
fn mix(a: Float32<rad/s, -35.0..=35.0>, b: Float32<rad/s, -35.0..=35.0>) -> Float32<rad/s, -35.0..=35.0> {
  (a + b) / 2.0
}
fn widen(x: Float32<1, 0.0..=1.0>) -> Float<1, 0.0..=1.0> {
  narrow<Float<1, 0.0..=1.0>>(x)
}
fn main() -> Int<0..=255> {
  print(gain(0.0) + 0.3);
  print(gain(5.0));
  print(widen(0.7));
  0
}
