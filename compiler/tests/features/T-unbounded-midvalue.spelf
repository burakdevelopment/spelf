module Feature.UnboundedMid
fault_hypothesis FH { channel_faults = 1, fault_mode = byzantine }
@output_bound(hypothesis = FH, horizon = 2, tolerance = 2, max_step = 5, bound = 2, unbounded = true)
fn mid(a: Int<-1000..=1000>, b: Int<-1000..=1000>, c: Int<-1000..=1000>) -> Int<-1000..=1000> {
  if a <= b { if b <= c { b } else { if a <= c { c } else { a } } }
  else { if a <= c { a } else { if b <= c { c } else { b } } }
}
