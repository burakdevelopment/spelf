module Feature.FixRounding
fn rq_ne(x: Fix<8, 2, 1>) -> Fix<8, 0, 1> { requantize<Fix<8, 0, 1>>(x, rounding = nearest_even) }
fn rq_fl(x: Fix<8, 2, 1>) -> Fix<8, 0, 1> { requantize<Fix<8, 0, 1>>(x, rounding = floor) }
fn rq_ce(x: Fix<8, 2, 1>) -> Fix<8, 0, 1> { requantize<Fix<8, 0, 1>>(x, rounding = ceil) }
fn rq_tz(x: Fix<8, 2, 1>) -> Fix<8, 0, 1> { requantize<Fix<8, 0, 1>>(x, rounding = toward_zero) }
fn show(x: Fix<8, 2, 1>) {
  print(rq_ne(x));
  print(rq_fl(x));
  print(rq_ce(x));
  print(rq_tz(x));
}
fn main() -> Int<0..=255> {
  show(requantize<Fix<8, 2, 1>>(2.5));
  show(requantize<Fix<8, 2, 1>>(-2.5));
  show(requantize<Fix<8, 2, 1>>(3.5));
  show(requantize<Fix<8, 2, 1>>(-3.75));
  0
}
