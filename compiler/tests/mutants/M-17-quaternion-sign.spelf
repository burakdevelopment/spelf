module Mutant.M17
struct Quat {
  w: Float<1, -1.0..=1.0>,
  x: Float<1, -1.0..=1.0>,
  y: Float<1, -1.0..=1.0>,
  z: Float<1, -1.0..=1.0>,
} invariant w >= 0.0
fn error_quat(w: Float<1, -1.0..=1.0>, x: Float<1, -1.0..=1.0>,
              y: Float<1, -1.0..=1.0>, z: Float<1, -1.0..=1.0>) -> Quat {
  Quat { w: w, x: x, y: y, z: z }
}
