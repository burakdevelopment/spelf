module Fixed.M24
fn control_step(err: Fix<16, 12, rad/s>, gain: Fix<16, 14, 1>) -> Fix<16, 8, rad/s> {
  let raw = err * gain;
  requantize<Fix<16, 8, rad/s>>(raw, rounding = nearest_even)
}
fn main() -> Int<0..=255> {
  let e1: Fix<16, 12, rad/s> = requantize<Fix<16, 12, rad/s>>(0.5[rad/s]);
  let g: Fix<16, 14, 1> = requantize<Fix<16, 14, 1>>(1.25);
  print(control_step(e1, g));
  let e2: Fix<16, 12, rad/s> = requantize<Fix<16, 12, rad/s>>(-0.5[rad/s]);
  print(control_step(e2, g));
  0
}
